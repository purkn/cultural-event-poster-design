{
  "_comment": "预制风格分桶规则。按 rules 顺序自上而下匹配，命中即停，因此优先级 = 数组顺序。字体性格比构图更能定义风格，所以字体类预设排在前面。match 里 typography / composition 是「或」关系，同一预设内两者都要满足才算命中；缺省字段表示不限。",
  "source_library": {
    "root": "libraries/reference_index/source_library",
    "index": "index.json",
    "note": "随 skill 附带参考图与源索引；相对路径以 skill 根目录解析。"
  },
  "value_regime_rules": {
    "_comment": "从 palette 文字推断明度家族，只是粗分，用于同一预设内部再分池，不作为风格判据。",
    "dark_prefix": [
      "黑",
      "灰黑",
      "青黑",
      "棕黑",
      "蓝黑",
      "绿黑",
      "红黑",
      "粉黑",
      "橙黑",
      "黄黑"
    ],
    "light_prefix": [
      "白",
      "米白",
      "米黄",
      "灰白",
      "青白"
    ],
    "light_suffix": [
      "白",
      "米白"
    ],
    "labels": {
      "light": "高调",
      "dark": "暗调",
      "mid": "中调偏彩",
      "color": "彩色中间调"
    }
  },
