  "substyles": {
    "_comment": "大桶内部的第二层。同一个主风格里，构图做法可能差很远，生图时要说清用哪个子风格。目前只覆盖视觉评审点过名的图，其余成员是 unassigned，用到时先看接触表再定。",
    "P03": [
      {
        "id": "hero-image",
        "name": "居中主视觉图像",
        "use_when": "有一个明确主体（人、物、插画）撑住画面中心",
        "members_note": "主视觉占中部，标题压上或置下"
      },
      {
        "id": "graphic-symbol",
        "name": "居中图形符号",
        "use_when": "没有摄影主体，用一个图形或符号当视觉中心",
        "members_note": "图形小而精，四周留白多"
      },
      {
        "id": "text-only",
        "name": "纯文字公告",
        "use_when": "信息就是主角，不需要主视觉",
        "members_note": "字排本身当画面，最考验字体和间距"
      }
    ],
    "P04": [
      {
        "id": "minimal-type",
        "name": "极简字排学术",
        "use_when": "讲座、论坛、学术放映，信息少而重",
        "members_note": "大量留白，字号对比拉开层级"
      },
      {
        "id": "illustration",
        "name": "插画配宋体",
        "use_when": "展览、出版类，需要一点温度但不失克制",
        "members_note": "插画占一块，宋体标题独立区"
      },
      {
        "id": "photo-editorial",
        "name": "照片编辑风",
        "use_when": "有摄影素材，想做出杂志内页感",
        "members_note": "照片不当满版用，切块配文字栏"
      }
    ],
    "P06": [
      {
        "id": "retro-gig",
        "name": "复古演出",
        "use_when": "乐队、放映、演出，要年代感",
        "members_note": "旧印刷质感、套色不准、纸张肌理"
      },
      {
        "id": "riso-pop",
        "name": "Riso 叠印波普",
        "use_when": "年轻受众、市集、独立文化",
        "members_note": "两三色叠印出错位和叠色"
      },
      {
        "id": "playful-display",
        "name": "活泼装饰字",
        "use_when": "节庆、亲子、社区，要热闹",
        "members_note": "标题本身就是图案"
      }
    ],
    "P07": [
      {
        "id": "doodle",
        "name": "涂鸦手写",
        "use_when": "社区、亲子、工作坊，要随意亲切",
        "members_note": "像手写上去的，不追求工整"
      },
      {
        "id": "cut-paper",
        "name": "剪贴拼贴",
        "use_when": "市集、独立出版、实验活动",
        "members_note": "撕边、纸张叠压、错位"
