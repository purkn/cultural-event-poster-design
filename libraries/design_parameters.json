      "purpose": "路径/轴向，可用于不同骨架"
    },
    "placement": {
      "values": [
        "centered",
        "offset",
        "distributed"
      ],
      "purpose": "锚点在画布的位置"
    },
    "typography": {
      "character": [
        "geometric",
        "serif",
        "sans",
        "calligraphic",
        "handmade",
        "experimental"
      ],
      "title_role": [
        "anchor",
        "partner",
