{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TypeBlueprintV015",
  "type": "object",
  "required": [
    "lead_id",
    "title_exact",
    "type_mode",
    "skeleton_class",
    "arrangement",
    "candidate_fonts",
    "type_visual_result"
  ],
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "title_exact": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string"
    },
    "type_mode": {
      "enum": [
        "REFERENCE_LED_DISPLAY_TYPE",
        "GLYPH_SAFE_ARTWORD",
        "IMAGE_INTEGRATED_H0",
        "CUSTOM_DISPLAY"
      ]
    },
    "skeleton_class": {
      "type": "string"
    },
    "reference_font_is_custom": {
      "type": "boolean"
    },
    "stroke_contrast": {
      "type": "string"
    },
    "apparent_weight": {
      "type": "string"
    },
    "apparent_width": {
      "type": "string"
    },
    "arrangement": {
      "type": "string"
    },
    "reference_crop": {
      "type": "string"
    },
    "glyph_observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidate_fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "coverage_ok"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "coverage_ok": {
            "type": "boolean"
          },
          "face_index": {
            "type": "integer"
          },
          "license": {
            "type": "string"
          }
        }
      }
    },
    "type_visual_result": {
      "enum": [
        "PASS",
        "AMBER",
        "RED",
        "UNVERIFIED"
      ]
    },
    "browser_evidence": {
      "type": "object"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
